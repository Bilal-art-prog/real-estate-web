# ── DATABASE ──────────────────────────────────────────────────────────────
# Default: zero-setup SQLite (file lives in server/prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Production: switch to managed Postgres (Neon / Supabase / Railway) AND change
# provider = "sqlite" → "postgresql" in prisma/schema.prisma, then re-migrate.
# DATABASE_URL="postgresql://user:pass@host:5432/bilal?schema=public"

# ── SERVER ────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated origins allowed to call the API (the static site's domain)
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"

# ── ADMIN AUTH ────────────────────────────────────────────────────────────
# Used by `npm run seed` to create the first admin login.
ADMIN_EMAIL="admin@bilalestate.pk"
ADMIN_PASSWORD="change-me-before-deploying"
# Long random string — signs the admin session cookie.
JWT_SECRET="replace-with-64-random-chars"

# ── LEAD NOTIFICATIONS (optional) ─────────────────────────────────────────
# Resend (https://resend.com) or any SMTP-compatible provider.
RESEND_API_KEY=""
NOTIFY_EMAIL="Muhammadbilal42030@gmail.com"
# WhatsApp Cloud API — notify yourself when a lead arrives.
WA_CLOUD_TOKEN=""
WA_CLOUD_PHONE_ID=""
