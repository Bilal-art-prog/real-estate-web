# ── FRONTEND (Vite build-time variables — must be prefixed VITE_) ──────────
# Point this at your deployed API and leads/events stop being browser-local.
# Leave empty to keep the offline localStorage mode.
VITE_API_BASE=

# Examples
# VITE_API_BASE=https://bilal-estate-api.onrender.com
# VITE_API_BASE=http://localhost:4000            (local development)

# Production domain, used for canonical URLs, Open Graph image and the
# absolute property links embedded in WhatsApp messages.
VITE_SITE_URL=https://bilalestate.pk

# ── NEVER put these in the frontend ────────────────────────────────────────
# Database URLs, service-role keys, SMTP/API secrets and admin passwords belong
# in server/.env only. Anything prefixed VITE_ is compiled into the public
# JavaScript bundle and readable by every visitor.
